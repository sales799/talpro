# Server
NODE_ENV=production
PORT=5001

# Database (PostgreSQL)
DATABASE_URL=postgresql://talpro:your_password_here@localhost:5432/talpro

# OpenAI (optional - enables AI features)
OPENAI_API_KEY=

# Base URL
VITE_BASE_URL=https://nirantar.talpro.in

# Social media webhook (optional)
SOCIAL_MEDIA_WEBHOOK_URL=

# SendGrid (optional - for email features)
SENDGRID_API_KEY=

# ── MCP Server (OAuth 2.1 + DCR) ────────────────────────────────────
# Public origin the MCP server is served at. Must match the URL clients use.
MCP_ISSUER=https://mcp.hcitalks.com

# HS256 secret used to sign MCP access-token JWTs. Auto-generated on first
# boot and logged once if unset — set it explicitly for production so tokens
# survive restarts and blue/green deploys.
MCP_JWT_SECRET=

# Comma-separated allowlist of emails permitted to complete the OAuth
# authorize flow. Leave blank to allow any email that knows the passcode.
MCP_ALLOWED_EMAILS=

# Shared passcode users enter on the /oauth/authorize login screen.
# Falls back to TALPRO_ADMIN_TOKEN when unset.
MCP_AUTH_PASSCODE=

# Optional override for the OAuth state SQLite file. Defaults to .data/mcp-oauth.sqlite.
MCP_OAUTH_DB_PATH=
