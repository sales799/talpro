# TalPro Blog AutoPublisher Configuration

# Required: Your blog webhook endpoint
BLOG_WEBHOOK_URL=http://localhost:5000/api/blog/webhook

# Optional: API key for authentication (if required by your webhook)
# BLOG_API_KEY=your-api-key-here

# Optional: Base URL for generating pretty blog URLs
BLOG_BASE_URL=https://talpro.in

# Optional: Endpoint to verify published posts
# BLOG_POSTS_URL=http://localhost:5000/api/blog/posts

# Initial batch: Number of posts to publish on startup (default: 10)
INITIAL_POSTS=10

# Daily batch: Number of posts to publish each day (default: 3)
DAILY_NUM_POSTS=3

# Daily schedule: Hour and minute in UTC (default: 09:00 UTC)
DAILY_UTC_HOUR=9
DAILY_UTC_MIN=0

# Delay between posts in milliseconds (default: 1000)
DELAY_MS=1000

# Request timeout in milliseconds (default: 20000)
TIMEOUT_MS=20000

# Success ratio threshold for enabling daily scheduler (default: 0.9 = 90%)
SUCCESS_RATIO=0.9

# Optional: Webhook to trigger after successful batch (e.g., deployment hook)
# REDEPLOY_HOOK_URL=https://api.example.com/deploy

# Dry run mode: Set to 1 to test without making actual API calls (default: 0)
DRY_RUN=0

# Optional: Custom title prefix for test posts (default: "TalPro Auto Test")
TITLE_PREFIX=TalPro Auto Test

# Optional: Comma-separated list of source URLs to cycle through
# FIXED_SOURCE_URLS=https://example.com/article1,https://example.com/article2

# Health server port (default: 3000)
PORT=3000
