# ===== Blog Gatekeeper AI Configuration =====

# Server
PORT=3000

# Database
DB_PATH=gatekeeper.db

# MinHash Similarity Detection
SIMILARITY_THRESHOLD=0.85
SIMILARITY_WINDOW_DAYS=365
MINHASH_K=64
SHINGLE_SIZE=3
MINHASH_SEED=1337

# AI Analysis (uses Replit AI Integrations - no API key needed)
AI_ANALYSIS_ENABLED=true
MIN_QUALITY_SCORE=6

# Platform Webhooks
# Required: where to send approved posts
PLATFORM_WEBHOOK_URL=http://localhost:5000/api/blog/webhook

# Optional: where to send posts that need review
PLATFORM_REVIEW_WEBHOOK_URL=

# Optional: HMAC signing of outbound requests
WEBHOOK_SECRET=

# ===== Auto-set by Replit AI Integrations =====
# AI_INTEGRATIONS_OPENAI_BASE_URL (automatically set)
# AI_INTEGRATIONS_OPENAI_API_KEY (automatically set)
